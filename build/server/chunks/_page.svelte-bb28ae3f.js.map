        <section><h3>Examples</h3>
            <p class="${"examples"}">Let ${escape(`\\(A = \\{1, 2\\}\\)`)} and ${escape(`\\(B = \\{2, 3, 4\\}\\)`)}, then ${escape(`\\(A- B = \\{1\\}\\)`)}</p>
