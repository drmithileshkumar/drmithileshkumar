  map: `{"version":3,"file":"+page.svelte","sources":["+page.svelte"],"sourcesContent":["<script id=\\"MathJax-script\\">\\r\\n    // @ts-nocheck\\r\\n        import {chapters, sections, selectedChapter, selectedSection} from '$lib/pages/notes/maths/stores';\\r\\n        import {presentationMode, presentation, overlay, slideCounter, autoScroll, currentSlide} from '$lib/pages/notes/maths/stores';\\r\\n        import Practice from '$lib/utils/practiceproblem/Practice.svelte';\\r\\n        import Message from '$lib/ui/Message.svelte';\\r\\n        import {Point2D} from '$lib/utils/common/point2d';\\r\\n        import {randNum, randInt} from '$lib/utils/common/common';\\r\\n        import { TeX } from '$lib/utils/common/constants';\\r\\n        import {page} from '$app/stores';\\r\\n        import {onMount} from 'svelte';\\r\\n        onMount(() => {\\r\\n            $selectedChapter = 'Sets';\\r\\n            $selectedSection = 'Practical problems';\\r\\n            $slideCounter = 11;\\r\\n            $currentSlide = -2;\\r\\n            MathJax.typeset();\\r\\n        });\\r\\n        let problemset = {\\r\\n            s: \\"\\",\\r\\n            o: {\\r\\n                    'A': '',\\r\\n                    'B': \\"\\",\\r\\n                    'C': \\"\\",\\r\\n                    'D': ''\\r\\n                },\\r\\n            c: \\"\\"\\r\\n        };\\r\\n        const generateProblem = (problemnumber) => {\\r\\n            let N = 1;\\r\\n            problemnumber = problemnumber % N;\\r\\n            let choices = ['A', 'B', 'C', 'D'];\\r\\n            let correctChoiceIndex = Math.floor(Math.random()*4);\\r\\n            problemset.c = choices[correctChoiceIndex];\\r\\n            let ans;\\r\\n            let values = [0, 0, 0, 0];\\r\\n            switch(problemnumber) {\\r\\n                case 0: {\\r\\n                    \\r\\n                    let m = randInt(20, 1);\\r\\n                    m = Math.random() > 0.5 ? -m : m;\\r\\n                    let n = m > 0 ? randInt(2*m, m + 1) : randInt(m + 1, m + 10);\\r\\n                    let m1 = randInt(20, 2);\\r\\n                    let n1 = randInt(Math.floor(m1/2), 0);\\r\\n                    let m2 = randInt(20, 2);\\r\\n                    let n2 = randInt(Math.floor(m2/2), 0);\\r\\n                    let m3 = randInt(20, 2);\\r\\n                    let n3 = randInt(Math.floor(m3/2), 0);\\r\\n    \\r\\n                    values[0] = \`\\\\\\\\(\${n} < x < \${m}\\\\\\\\)\`;\\r\\n                    values[1] = \`\\\\\\\\(\${n1} < x < \${m1}\\\\\\\\)\`;\\r\\n                    values[2] = \`\\\\\\\\(\${n2} < x < \${m2}\\\\\\\\)\`;\\r\\n                    values[3] = \`\\\\\\\\(\${n3} < x < \${m3}\\\\\\\\)\`;\\r\\n                    for(let i = 0; i < 4; i++) {\\r\\n                        problemset.o[choices[(correctChoiceIndex + i) % 4]] = values[i];\\r\\n                    } \\r\\n                    \\r\\n                    problemset.s = \`Which of the following will correspond to an empty set?\`;\\r\\n                    break;\\r\\n                }\\r\\n            }\\r\\n            problemset = problemset;\\r\\n            return problemset;\\r\\n        }\\r\\n    <\/script>\\r\\n    <style>\\r\\n        /* p {\\r\\n            text-indent: 2em;\\r\\n        } */\\r\\n        .image {\\r\\n            display: flex;\\r\\n            justify-content: center;\\r\\n            width: min(95vw, 300px);\\r\\n            margin: auto;\\r\\n        }\\r\\n    </style>\\r\\n    <svelte:head>\\r\\n        <title>{$selectedSection}</title>\\r\\n        <link rel=\\"canonical\\" href=\\"https://drmithileshkumar.com{$page.url.pathname}\\" />\\r\\n        <meta name=\\"description\\" content=\\"Practical problems on sets\\" />\\r\\n        \\r\\n    </svelte:head>\\r\\n    <article class:absolute={$presentationMode} bind:this={$presentation}>\\r\\n        <h1>{$selectedSection}</h1>\\r\\n        <section>\\r\\n            <p>To define complement of a set we need to fix a universal set first.</p>\\r\\n        </section>\\r\\n        <section>\\r\\n            <div class=\\"remark\\">\\r\\n                <p>\\r\\n                 Let \\\\(A\\\\) and \\\\(B\\\\) be finite sets. If \\\\(A\\\\cap B = \\\\phi\\\\), then {\`\\\\\\\\(n(A\\\\\\\\cup B) = n(A) + n(B)\\\\\\\\)\`}\\r\\n                </p>\\r\\n            </div>\\r\\n            <div class=\\"remark\\">\\r\\n                <p>\\r\\n                 Let \\\\(A\\\\) and \\\\(B\\\\) be finite sets, then {\`\\\\\\\\(n(A\\\\\\\\cup B) = n(A) + n(B) - n(A\\\\\\\\cap B)\\\\\\\\)\`}\\r\\n                </p>\\r\\n            </div>\\r\\n            <div class=\\"image\\">\\r\\n                <svg width=\\"100%\\" height=\\"100%\\" viewBox=\\"-253 -136 510 310\\" xmlns=\\"http://www.w3.org/2000/svg\\" xmlns:xlink=\\"http://www.w3.org/1999/xlink\\">\\r\\n                    <defs></defs><g>\\r\\n                            <g  \\r\\n                                class='draggable'\\r\\n                                id='Layer-VectorialApp1R60-0'\\r\\n                                fill='none'\\r\\n                                stroke='none'\\r\\n                                stroke-width='0'\\r\\n                                stroke-dasharray='none'\\r\\n                                opacity='1'\\r\\n                                mask='none'\\r\\n                                filter='none'\\r\\n                                transform='matrix(1 0 0 1 0 0)'\\r\\n                            >\\r\\n                            \\r\\n                            <rect  \\r\\n                                id='Rect-VectorialApp1R60-2'\\r\\n                                x='0'\\r\\n                                y='0'\\r\\n                                width='500'\\r\\n                                height='300'\\r\\n                                rx='0'\\r\\n                                ry='0'\\r\\n                                fill='rgba